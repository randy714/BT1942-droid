<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gdroid_bg"
    android:padding="16dp">

    <!-- Top Bar G-DROID -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BATTLEFIELD 1942"
                    android:textColor="@color/gdroid_text_main"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvEngineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Engine: Built-in Standalone"
                    android:textColor="@color/gdroid_cyan"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvFpsDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="60 FPS"
            android:textColor="@color/gdroid_amber"
            android:textStyle="bold"
            android:textSize="12sp" />
    </RelativeLayout>

    <!-- Banner Dashboard Game Card -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imgTankBanner"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_launcher"
            android:alpha="0.8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/btnLaunchGame"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="16dp"
            android:text="G-DROID ENGINE v2.5 ACTIVE"
            android:textColor="@color/gdroid_text_sub"
            android:letterSpacing="0.1"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLaunchGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:backgroundTint="@color/gdroid_cyan"
            android:text="@string/launch_game"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Bottom Navigation Dashboard Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnOpenSettings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:text="SETTINGS"
            android:textColor="@color/gdroid_text_main"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnSelectFolder"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:text="MODS / DATA"
            android:textColor="@color/gdroid_text_main"
            android:layout_marginHorizontal="3dp"/>

        <Button
            android:id="@+id/btnControlsLayout"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:text="LAYOUT"
            android:textColor="@color/gdroid_text_main"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
