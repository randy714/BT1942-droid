<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BATTLEFIELD 1942"
        android:textColor="@color/gold"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENGINE LAUNCHER v1.0"
        android:textColor="@color/lgreen"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Folder game belum dipilih"
        android:textColor="@color/lgray"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnFolder"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:text="PILIH FOLDER GAME B1942"
        android:backgroundTint="@color/olive"
        android:textColor="@color/gold"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:text="▶ PLAY"
        android:backgroundTint="@color/green"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:enabled="false"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="300dp"
        android:layout_height="50dp"
        android:text="⚙ SETTINGS"
        android:backgroundTint="@color/olive"
        android:textColor="@color/gold" />

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gray"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginTop="16dp" />
</LinearLayout>
