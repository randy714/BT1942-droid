<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gdroid_bg"
    android:padding="16dp">

    <!-- Header G-DROID -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BATTLEFIELD 1942"
                android:textColor="@color/gdroid_text_main"
                android:textStyle="bold"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/tvEngineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/engine_standalone"
                android:textColor="@color/gdroid_cyan"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFpsDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_card"
            android:padding="8dp"
            android:text="60 FPS"
            android:textColor="@color/gdroid_amber"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Banner -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_launcher"
            android:alpha="0.9" />

        <Button
            android:id="@+id/btnLaunchGame"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            android:backgroundTint="@color/gdroid_cyan"
            android:text="@string/launch_game"
            android:textColor="#000000"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Navigasi Bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">
        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:text="@string/tab_settings"
            android:textColor="@color/gdroid_text_main"
            android:layout_marginEnd="4dp"/>
        <Button
            android:id="@+id/btnSelectFolder"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:text="MODS"
            android:textColor="@color/gdroid_text_main"
            android:layout_marginHorizontal="2dp"/>
        <Button
            android:id="@+id/btnControlsLayout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:text="@string/tab_controls"
            android:textColor="@color/gdroid_text_main"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
